{
  "name": "apps-stock-fighter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "granite dev",
    "build": "ait build",
    "deploy": "ait deploy",
    "lint": "eslint .",
    "test:logic": "node --test tests/*.test.mjs",
    "test:home": "node --test tests/homeLayoutContract.test.mjs",
    "test:quiz": "node --test tests/quizLayoutContract.test.mjs tests/stockFighterLogic.test.mjs",
    "test:chase": "node --test tests/chaseLayoutContract.test.mjs tests/stockFighterLogic.test.mjs",
    "test:ending": "node --test tests/endingLayoutContract.test.mjs tests/stockFighterLogic.test.mjs",
    "verify:full": "npm run test:logic && npm run lint && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.4.7",
    "@emotion/react": "^11.14.0",
    "@toss/tds-colors": "^0.1.0",
    "@toss/tds-mobile": "^2.3.0",
    "@toss/tds-mobile-ait": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
